  phoneNumber       String?
  whatsappNumber    String?
  email             String?
  address           String?           @db.Text
  joinDate          DateTime          @db.Date
  leaveDate         DateTime?         @db.Date
  baseMonthlySalary Decimal           @db.Decimal(12, 2)
  isActive          Boolean           @default(true)
  notes             String?           @db.Text
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Relations
  madrasa           Madrasa                  @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  schedules         UstadhSchedule[]
  attendanceRecords UstadhAttendanceRecord[]
  salaries          UstadhSalary[]
  examinedQualifications StudentQualification[] @relation("QualificationExaminerUstadh")
  reportedIncidents      StudentIncident[]      @relation("IncidentReportedByUstadh")
  studentMeetings        StudentMeeting[]       @relation("MeetingUstadh")

// MadrasaNexa Multi-Tenant Prisma Schema
// Provider: MySQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Exactly 9)
// ==========================================

enum UserRole {
  SUPER_ADMIN
  MADRASA_ADMIN
}

enum MadrasaStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum OnboardingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  COMPLETED
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum WhatsAppStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum FileType {
  MADRASA_LOGO
  STUDENT_PHOTO
  STUDENT_DOCUMENT
  REPORT
  RECEIPT
  OTHER
  ABOUT_US_HERO
  ABOUT_US_STORY
  SUBSCRIPTION_RECEIPT
  EXAM_PAST_PAPER
  CURRICULUM_RESOURCE
  MADRASA_HERO_IMAGE
}

enum PaymentVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AboutUsStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum AboutUsLanguage {
  AR
  TA
}

enum AboutUsTranslationState {
  DRAFT
  PUBLISHED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AnnouncementAudience {
  ALL_MADRASAS
  SELECTED_MADRASAS
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementCategory {
  GENERAL
  SYSTEM
  MAINTENANCE
  UPDATE
  BILLING
  EVENT
  OTHER
}

enum MarkingAssessmentStatus {
  DRAFT
  FINALIZED
}

enum EmailSenderMode {
  PLATFORM
  CUSTOM_SMTP
}

enum SmtpSecurity {
  SSL_TLS
  STARTTLS
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
  DELIVERY_UNKNOWN
  SKIPPED_NO_RECIPIENT
}

enum NotificationEventType {
  FEE_PARTIAL_PAYMENT
  FEE_FULLY_PAID
  FEE_MONTH_END_REMINDER
  SALARY_PAID
  TIMETABLE_FINALIZED
  FOLLOW_UP_ASSIGNED
  FOLLOW_UP_REMINDER
  INVOICE_DUE_SOON_REMINDER
  APPLICATION_STATUS_UPDATE
  EXAM_RESULT_PUBLISHED
  DAILY_ACTIVITY_LOGGED
  MADRASA_NOTICE_BROADCAST
}

enum TimetableRecipientScope {
  ALL_TEACHING_STAFF
  USTADH_ONLY
  SCHOOL_TEACHER_ONLY
  SELECTED_STAFF
  AFFECTED_STAFF_ONLY
}

enum InterviewRound {
  FIRST
  SECOND
}

enum InterviewSchedulingMethod {
  SAME_TIME
  INDIVIDUAL_SLOTS
}

enum InterviewAppointmentStatus {
  SCHEDULED
  RESCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InterviewAttendance {
  PRESENT
  ABSENT
}

enum InterviewResult {
  PENDING
  PASSED
  NEEDS_SECOND_INTERVIEW
  REJECTED
}

enum InterviewEmailStatus {
  PENDING
  CLAIMED
  SENT
  FAILED
  UNCERTAIN
}

// ==========================================
// MODELS (Exactly 17)
// ==========================================

/// Platform Users (SUPER_ADMIN or MADRASA_ADMIN)
model User {
  reviewedApplications StudentApplication[] @relation("ApplicationReviewedBy")
  uploadedPastPapers ExamPastPaper[] @relation("PastPaperUploadedBy")
  uploadedCurriculumResources CurriculumResource[] @relation("CurriculumUploadedBy")
  recordedDailyActivities StudentDailyActivity[] @relation("ActivityRecordedBy")
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               UserRole
  madrasaId          String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  madrasa              Madrasa?                   @relation(fields: [madrasaId], references: [id], onDelete: SetNull)
  activityLogs         ActivityLog[]
  reviewedOnboardings  MadrasaOnboardingRequest[] @relation("ReviewedOnboardings")
  createdAnnouncements       Announcement[]                  @relation("CreatedAnnouncements")
  announcementReads          AnnouncementRead[]
  reviewedPaymentSubmissions SubscriptionPaymentSubmission[] @relation("ReviewedPaymentSubmissions")
  publishedHomepageContents  HomepageContent[]               @relation("PublishedHomepageContent")
  createdMarkingAssessments  MarkingAssessment[]             @relation("CreatedAssessments")
  createdAttendanceSessions  AttendanceSession[]             @relation("CreatedAttendanceSessions")
  recordedUstadhAttendances  UstadhAttendanceRecord[]        @relation("RecordedUstadhAttendance")
  paidUstadhSalaries         UstadhSalary[]                  @relation("PaidUstadhSalaries")
  createdExpenses            Expense[]                       @relation("ExpenseCreatedBy")
  updatedExpenses            Expense[]                       @relation("ExpenseUpdatedBy")
  publishedTimetables        TimetablePublication[]          @relation("PublishedTimetables")
  createdStudentQualifications  StudentQualification[]       @relation("QualificationCreatedBy")
  reviewedStudentQualifications StudentQualification[]       @relation("QualificationReviewedBy")
  reportedStudentIncidents      StudentIncident[]            @relation("IncidentReportedByUser")
  reviewedStudentIncidents      StudentIncident[]            @relation("IncidentReviewedByUser")
  createdStudentMeetings        StudentMeeting[]             @relation("MeetingCreatedByUser")
  createdStudentFollowUps       StudentFollowUp[]            @relation("FollowUpCreatedByUser")
  assignedStudentFollowUps      StudentFollowUp[]            @relation("FollowUpAssignedToUser")
  completedStudentFollowUps     StudentFollowUp[]            @relation("FollowUpCompletedByUser")
  publishedAlumniProfiles       AlumniProfile[]              @relation("AlumniPublishedBy")
  recordedAlumniConsents        AlumniConsentRecord[]        @relation("ConsentRecordRecordedBy")
  requestedAlumniVerifications  AlumniVerificationRequest[]  @relation("AlumniRequestedByUser")
  respondedAlumniVerifications  AlumniVerificationRequest[]  @relation("AlumniRespondedByUser")
  createdInterviewSchedules     InterviewSchedule[]          @relation("ScheduleCreatedBy")
  createdInterviewAppointments  InterviewAppointment[]       @relation("AppointmentCreatedBy")
  recordedInterviewEvaluations  InterviewEvaluation[]        @relation("EvaluationEvaluatedBy")
  createdFeatureOverrides       MadrasaFeatureOverride[]     @relation("OverrideCreatedBy")
  updatedFeatureOverrides       MadrasaFeatureOverride[]     @relation("OverrideUpdatedBy")

  @@index([madrasaId])
  @@index([role])
  @@map("users")
}

/// Tenant Institution
model Madrasa {
  profile MadrasaProfile?
  admissionPeriods AdmissionPeriod[]
  studentApplications StudentApplication[]
  examPastPapers ExamPastPaper[]
  curriculumResources CurriculumResource[]
  studentDailyActivities StudentDailyActivity[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues CustomFieldValue[]
  id         String        @id @default(cuid())
  code       String        @unique
  name       String
  slug       String        @unique
  email      String?
  phone      String?
  address    String?       @db.Text
  status     MadrasaStatus @default(ACTIVE)
  logoFileId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  archivedAt DateTime?

  // Relations
  users                 User[]
  settings              MadrasaSetting?
  subscriptions         Subscription[]
  subscriptionPayments  SubscriptionPayment[]
  academicSections      AcademicSection[]
  classes               Class[]
  students              Student[]
  studentFeeSettings    StudentFeeSetting[]
  invoices              Invoice[]
  invoiceItems          InvoiceItem[]
  payments              Payment[]
  paymentAllocations    PaymentAllocation[]
  receipts              Receipt[]
  whatsAppLogs          WhatsAppLog[]
  fileObjects           FileObject[]
  activityLogs                  ActivityLog[]
  onboardingRequests            MadrasaOnboardingRequest[]
  targetedAnnouncements         AnnouncementMadrasa[]
  subscriptionPaymentSubmissions SubscriptionPaymentSubmission[]
  subjects                      Subject[]
  markingAssessments            MarkingAssessment[]
  markingAssessmentSubjects     MarkingAssessmentSubject[]
  studentMarks                  StudentMark[]
  attendanceSessions            AttendanceSession[]
  attendanceRecords             AttendanceRecord[]
  ustadhs                       Ustadh[]
  ustadhSchedules               UstadhSchedule[]
  ustadhAttendanceRecords       UstadhAttendanceRecord[]
  ustadhSalaries                UstadhSalary[]
  timetableBreaks               TimetableBreak[]
  expenseCategories             ExpenseCategory[]
  expenses                      Expense[]
  expenseBudgets                ExpenseBudget[]
  expenseMonthlyInsights        ExpenseMonthlyInsight[]
  notificationJobs              NotificationJob[]
  timetablePublications         TimetablePublication[]
  emailSettings                 MadrasaEmailSetting?
  studentQualifications         StudentQualification[]
  studentIncidents              StudentIncident[]
  studentMeetings               StudentMeeting[]
  studentFollowUps              StudentFollowUp[]
  alumniProfiles                AlumniProfile[]
  alumniIndexSequences          AlumniIndexSequence[]
  alumniConsentRecords          AlumniConsentRecord[]
  targetAlumniVerifications     AlumniVerificationRequest[] @relation("AlumniTargetMadrasa")
  requestedAlumniVerifications  AlumniVerificationRequest[] @relation("AlumniRequestingMadrasa")
  interviewSchedules            InterviewSchedule[]
  interviewAppointments         InterviewAppointment[]
  interviewEvaluations          InterviewEvaluation[]
  interviewNotifications        InterviewNotification[]
  featureOverrides              MadrasaFeatureOverride[]

  @@index([status])
  @@map("madrasas")
}

/// Dynamic Subscription Plans
model Plan {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  description    String?  @db.Text
  durationMonths Int
  price          Decimal  @db.Decimal(12, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  subscriptions      Subscription[]
  paymentSubmissions SubscriptionPaymentSubmission[]
  planFeatures       PlanFeature[]

  @@map("plans")
}

/// Historical Madrasa Subscriptions
model Subscription {
  id                       String             @id @default(cuid())
  madrasaId                String
  planId                   String
  status                   SubscriptionStatus @default(ACTIVE)
  startsAt                 DateTime
  endsAt                   DateTime
  priceAtPurchase          Decimal            @db.Decimal(12, 2)
  durationMonthsAtPurchase Int
  renewedAt                DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  // Relations
  madrasa              Madrasa                         @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  plan                 Plan                            @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptionPayments SubscriptionPayment[]
  paymentSubmissions   SubscriptionPaymentSubmission[]

  @@index([madrasaId])
  @@index([status])
  @@index([endsAt])
  @@map("subscriptions")
}

/// Platform Subscription Payments
model SubscriptionPayment {
  id             String        @id @default(cuid())
  madrasaId      String
  subscriptionId String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  reference      String?
  paidAt         DateTime      @default(now())
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())

  // Relations
  madrasa            Madrasa                         @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  subscription       Subscription                    @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentSubmissions SubscriptionPaymentSubmission[]

  @@index([madrasaId])
  @@index([subscriptionId])
  @@index([paidAt])
  @@map("subscription_payments")
}

/// Tenant Academic Sections (e.g. Hifz, Kitab, Primary, Arabic, etc. - dynamic)
model AcademicSection {
  id          String   @id @default(cuid())
  madrasaId   String
  name        String
  code        String?
  description String?  @db.Text
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  classes Class[]

  @@unique([id, madrasaId])
  @@unique([madrasaId, name])
  @@unique([madrasaId, code])
  @@index([madrasaId, isActive, sortOrder])
  @@map("academic_sections")
}

/// Tenant Classes
model Class {
  id                String   @id @default(cuid())
  madrasaId         String
  academicSectionId String?
  name              String
  code              String?
  description       String?  @db.Text
  defaultMonthlyFee Decimal  @db.Decimal(12, 2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  madrasa         Madrasa          @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  academicSection AcademicSection? @relation(fields: [academicSectionId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  students        Student[]
  markingAssessments MarkingAssessment[]
  attendanceSessions AttendanceSession[]
  ustadhSchedules    UstadhSchedule[]
  timetableBreaks    TimetableBreak[]
  examPastPapers ExamPastPaper[]
  curriculumResources CurriculumResource[]
  studentApplications StudentApplication[]

  // Tenant-scoped uniqueness
  @@unique([id, madrasaId])
  @@unique([madrasaId, academicSectionId, name])
  @@unique([madrasaId, code])
  @@index([madrasaId])
  @@index([madrasaId, academicSectionId, isActive])
  @@map("classes")
}

/// Tenant Students
model Student {
  convertedApplications StudentApplication[]
  dailyActivities StudentDailyActivity[]
  id              String        @id @default(cuid())
  madrasaId       String
  classId         String?
  admissionNo     String
  fullName        String
  guardianName    String
  guardianPhone   String?
  guardianEmail   String?       @db.VarChar(255)
  whatsappNumber  String?
  whatsappOptIn   Boolean       @default(false)
  whatsappOptInAt DateTime?
  address         String?       @db.Text
  admissionDate   DateTime
  monthlyFee      Decimal?      @db.Decimal(12, 2)
  status          StudentStatus @default(ACTIVE)
  photoFileId     String?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  madrasa      Madrasa             @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  class        Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeSettings  StudentFeeSetting[]
  invoices     Invoice[]
  payments     Payment[]
  whatsAppLogs WhatsAppLog[]
  studentMarks StudentMark[]
  attendanceRecords AttendanceRecord[]
  qualifications    StudentQualification[]
  incidents         StudentIncident[]
  meetings          StudentMeeting[]
  followUps         StudentFollowUp[]
  alumniProfile     AlumniProfile?

  // Critical: Admission number unique per Madrasa
  @@unique([madrasaId, admissionNo])
  // Compound unique key for tenant-aware relation from Invoice & Payment
  @@unique([id, madrasaId])
  @@index([madrasaId, classId])
  @@index([madrasaId, status])
  @@map("students")
}

/// Student Fee History
model StudentFeeSetting {
  id            String    @id @default(cuid())
  madrasaId     String
  studentId     String
  amount        Decimal   @db.Decimal(12, 2)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  reason        String?
  createdAt     DateTime  @default(now())

  // Relations (Enforcing same-tenant relation to student)
  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  student Student @relation(fields: [studentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)

  @@unique([madrasaId, studentId, effectiveFrom])
  @@index([madrasaId, studentId])
  @@index([effectiveFrom])
  @@map("student_fee_settings")
}

/// Tenant Invoices
model Invoice {
  id             String        @id @default(cuid())
  madrasaId      String
  studentId      String
  invoiceNo      String
  billingYear    Int
  billingMonth   Int
  issueDate      DateTime
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAmount  Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  madrasa      Madrasa             @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  student      Student             @relation(fields: [studentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  items        InvoiceItem[]
  allocations  PaymentAllocation[]
  whatsAppLogs WhatsAppLog[]

  // Compound key for tenant-aware foreign keys from items & allocations
  @@unique([id, madrasaId])
  // Tenant-scoped invoice number
  @@unique([madrasaId, invoiceNo])
  // Prevent duplicate invoice for student in same month
  @@unique([madrasaId, studentId, billingYear, billingMonth])
  @@index([madrasaId, status])
  @@index([madrasaId, billingYear, billingMonth])
  @@index([madrasaId, studentId])
  @@map("invoices")
}

/// Invoice Line Items
model InvoiceItem {
  id          String   @id @default(cuid())
  madrasaId   String
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitAmount  Decimal  @db.Decimal(12, 2)
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  // Relations (Enforcing same-tenant relation to invoice)
  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId, madrasaId], references: [id, madrasaId], onDelete: Restrict)

  @@index([madrasaId, invoiceId])
  @@map("invoice_items")
}

/// Financial Payments
model Payment {
  id             String        @id @default(cuid())
  madrasaId      String
  studentId      String
  paymentNo      String
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  reference      String?
  idempotencyKey String?
  notes          String?       @db.Text
  status         PaymentStatus @default(COMPLETED)
  paidAt         DateTime      @default(now())
  voidedAt       DateTime?
  voidReason     String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  madrasa      Madrasa             @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  student      Student             @relation(fields: [studentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  allocations  PaymentAllocation[]
  receipt      Receipt?
  whatsAppLogs WhatsAppLog[]

  // Compound key for tenant-aware foreign keys from receipt & allocations
  @@unique([id, madrasaId])
  // Tenant-scoped uniqueness
  @@unique([madrasaId, paymentNo])
  @@unique([madrasaId, idempotencyKey])
  @@index([madrasaId, studentId])
  @@index([madrasaId, paidAt])
  @@index([madrasaId, status])
  @@map("payments")
}

/// Payment Allocation for Partial and Multi-Invoice Payments
model PaymentAllocation {
  id        String   @id @default(cuid())
  madrasaId String
  paymentId String
  invoiceId String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  // Relations (Enforcing same-tenant relation for payment & invoice)
  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  invoice Invoice @relation(fields: [invoiceId, madrasaId], references: [id, madrasaId], onDelete: Restrict)

  // Prevent duplicate allocation row for same payment and invoice
  @@unique([paymentId, invoiceId])
  @@index([madrasaId, paymentId])
  @@index([madrasaId, invoiceId])
  @@map("payment_allocations")
}

/// Official Payment Receipts
model Receipt {
  id        String   @id @default(cuid())
  madrasaId String
  paymentId String   @unique
  receiptNo String
  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  // Relations (Enforcing same-tenant relation for payment)
  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)

  @@unique([id, madrasaId])
  @@unique([paymentId, madrasaId])
  @@unique([madrasaId, receiptNo])
  @@index([madrasaId, issuedAt])
  @@map("receipts")
}

/// WhatsApp Notification and Message Logs
model WhatsAppLog {
  id                String         @id @default(cuid())
  madrasaId         String
  studentId         String?
  invoiceId         String?
  paymentId         String?
  batchId           String?
  phoneNumber       String
  messageType       String
  status            WhatsAppStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?        @db.Text
  retryCount        Int            @default(0)
  sentAt            DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  madrasa Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([madrasaId, status])
  @@index([batchId])
  @@index([madrasaId, createdAt])
  @@map("whatsapp_logs")
}

/// Cloudflare R2 File Metadata
model FileObject {
  examPastPapers ExamPastPaper[]
  curriculumResources CurriculumResource[]
  id           String   @id @default(cuid())
  madrasaId    String?
  type         FileType
  objectKey    String   @unique
  originalName String
  mimeType     String
  size         Int
  publicUrl    String?
  createdAt    DateTime @default(now())

  // Relations
  madrasa Madrasa? @relation(fields: [madrasaId], references: [id], onDelete: SetNull)

  // About Us Relations
  aboutUsDraftHeroFiles      AboutUs[] @relation("AboutUsDraftHeroFile")
  aboutUsDraftStoryFiles     AboutUs[] @relation("AboutUsDraftStoryFile")
  aboutUsPublishedHeroFiles  AboutUs[] @relation("AboutUsPublishedHeroFile")
  aboutUsPublishedStoryFiles AboutUs[] @relation("AboutUsPublishedStoryFile")

  // Subscription Payment Receipts
  subscriptionPaymentReceipts SubscriptionPaymentSubmission[] @relation("SubscriptionPaymentReceipt")

  // Student Private Documents (Certificates & Incident Evidence)
  studentQualificationCertificates StudentQualification[] @relation("QualificationCertificateFile")
  studentIncidentEvidences         StudentIncident[]      @relation("IncidentEvidenceFile")
  alumniConsentFiles               AlumniProfile[]        @relation("AlumniConsentFile")
  alumniConsentRecordFiles         AlumniConsentRecord[]  @relation("ConsentRecordEvidenceFile")
  appointmentInvitationFiles       InterviewAppointment[] @relation("AppointmentInvitationFile")
  notificationAttachmentFiles      InterviewNotification[] @relation("NotificationAttachmentFile")

  @@unique([id, madrasaId])
  @@index([madrasaId, type])
  @@map("file_objects")
}

/// Madrasa-specific Settings
model MadrasaSetting {
  id            String   @id @default(cuid())
  madrasaId     String   @unique
  invoicePrefix String   @default("INV-")
  receiptPrefix String   @default("REC-")
  currency      String   @default("LKR")
  timezone      String   @default("Asia/Colombo")
  academicYear  String?
  receiptHeader String?  @db.Text
  receiptFooter String?  @db.Text
  gpaScale      Json?

  // Symmetrical Notification Settings
  autoFeePaymentSmsEnabled    Boolean  @default(false)
  autoPartialFeeSmsEnabled    Boolean  @default(false)
  autoFeeReminderSmsEnabled   Boolean  @default(false)

  autoFeePaymentEmailEnabled  Boolean  @default(false)
  autoPartialFeeEmailEnabled  Boolean  @default(false)
  autoFeeReminderEmailEnabled Boolean  @default(false)

  autoSalaryPaidEmailEnabled  Boolean  @default(true)
  feeReminderSendTime         String   @default("09:00") @db.VarChar(5)

  // Centralized Date & Time Settings
  dateFormat                  String   @default("DD/MM/YYYY") @db.VarChar(20)
  timeFormat                  String   @default("12_HOUR") @db.VarChar(10)
  workingHoursStart           String   @default("07:30") @db.VarChar(5)
  workingHoursEnd             String   @default("16:30") @db.VarChar(5)
  workingDays                 Json?
  weeklyHolidays              Json?
  attendanceStartTime         String   @default("07:30") @db.VarChar(5)
  attendanceClosingTime       String   @default("08:30") @db.VarChar(5)
  lateMarkingTime             String   @default("08:00") @db.VarChar(5)
  attendanceGracePeriodMinutes Int     @default(15)

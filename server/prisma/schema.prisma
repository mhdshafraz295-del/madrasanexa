// ==========================================
// EXPENSE ANALYSIS MODELS & ENUMS
// ==========================================

enum ExpenseStatus {
  ACTIVE
  VOID
}

/// Category for outgoing operational expenses
model ExpenseCategory {
  id          String   @id @default(cuid())
  madrasaId   String
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  madrasa  Madrasa                  @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  expenses Expense[]
  budgets  ExpenseBudget[]
  insights ExpenseMonthlyInsight[]

  @@unique([madrasaId, name])
  @@index([madrasaId, isActive])
  @@map("expense_categories")
}

/// Outgoing operational expense record
model Expense {
  id            String        @id @default(cuid())
  madrasaId     String
  categoryId    String
  expenseDate   DateTime      @db.Date
  description   String        @db.VarChar(255)
  amount        Decimal       @db.Decimal(12, 2)
  quantity      Decimal?      @db.Decimal(12, 3)
  unitLabel     String?       @db.VarChar(50)
  unitCost      Decimal?      @db.Decimal(12, 2)
  supplierName  String?       @db.VarChar(150)
  reasonNote    String?       @db.Text
  status        ExpenseStatus @default(ACTIVE)
  voidReason    String?       @db.VarChar(500)
  voidedAt      DateTime?
  createdById   String
  updatedById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  madrasa   Madrasa         @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  category  ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy User?           @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])

  @@index([madrasaId, expenseDate])
  @@index([madrasaId, categoryId])
  @@index([madrasaId, status])
  @@map("expenses")
}

/// Monthly operational budget per category
model ExpenseBudget {
  id         String   @id @default(cuid())
  madrasaId  String
  categoryId String
  year       Int
  month      Int
  amount     Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  madrasa  Madrasa         @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([madrasaId, categoryId, year, month])
  @@index([madrasaId, year, month])
  @@map("expense_budgets")
}

/// Admin qualitative analysis note and action plan per category and month
model ExpenseMonthlyInsight {
  id          String   @id @default(cuid())
  madrasaId   String
  categoryId  String
  year       Int
  month      Int
  adminReason String?  @db.Text
  actionPlan  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  madrasa  Madrasa         @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([madrasaId, categoryId, year, month])
  @@index([madrasaId, year, month])
  @@map("expense_monthly_insights")
}

/// Universal Async Notification Job & Audit Trail
model NotificationJob {
  id                  String                @id @default(cuid())
  madrasaId           String
  channel             NotificationChannel
  eventType           NotificationEventType
  recipientType       String                @db.VarChar(50) // GUARDIAN, STAFF
  recipientEntityId   String?               @db.VarChar(191) // studentId or ustadhId
  recipientAddress    String?               @db.VarChar(255) // Nullable for SKIPPED_NO_RECIPIENT
  recipientName       String?               @db.VarChar(255)
  subject             String?               @db.VarChar(255)
  message             String                @db.Text
  payloadJson         Json?
  relatedEntityType   String?               @db.VarChar(50)  // Payment, Invoice, UstadhSalary, TimetablePublication
  relatedEntityId     String?               @db.VarChar(191)
  dedupeKey           String                @db.VarChar(255)
  status              NotificationStatus    @default(PENDING)
  attemptCount        Int                   @default(0)
  maxAttempts         Int                   @default(3)
  nextAttemptAt       DateTime?             @default(now())
  processingStartedAt DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  lastError           String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)

  @@unique([madrasaId, dedupeKey])
  @@index([madrasaId, status, nextAttemptAt])
  @@index([madrasaId, channel, createdAt])
  @@index([madrasaId, eventType, createdAt])
  @@index([status, processingStartedAt])
  @@map("notification_jobs")
}

/// Timetable Finalization and Publication Metadata

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Future services (Optional for Phase 1)
DATABASE_URL="mysql://root:@127.0.0.1:3306/madrasanexa"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Cloudflare R2 (Optional for Phase 1)
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=YOUR_R2_PUBLIC_URL

# Email Sender Credential Encryption Key (64 hex characters = 32 bytes)
EMAIL_CREDENTIAL_ENCRYPTION_KEY=YOUR_64_HEX_CHARACTER_KEY

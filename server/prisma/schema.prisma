enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TeachingStaffType {
  USTADH
  SCHOOL_TEACHER
}

enum UstadhSalaryStatus {
  PENDING
  PAID
}

/// Ustadh Staff Profile
model Ustadh {
  id                String            @id @default(cuid())
  madrasaId         String
  ustadhCode        String
  staffType         TeachingStaffType @default(USTADH)

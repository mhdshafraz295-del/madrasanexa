// ==========================================
// ALUMNI & VERIFICATION ENUMS
// ==========================================

enum AlumniPublicationStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
  REVOKED
}

enum AlumniConsentStatus {
  PENDING
  GRANTED
  WITHDRAWN
}

enum AlumniConsentParty {
  STUDENT
  GUARDIAN
  BOTH
}

enum AlumniConsentAction {
  INITIAL_GRANT
  WITHDRAWAL
  RENEWAL
}

enum CharacterConductRating {
  EXCELLENT
  VERY_GOOD
  GOOD
  SATISFACTORY
  CONDITIONAL
}

enum AlumniVerificationStatus {
  PENDING
  APPROVED_VERIFIED
  REJECTED
  CLOSED
}

// ==========================================
// ALUMNI MODELS
// ==========================================

/// Alumni Profile (Single canonical alumni record per student)
model AlumniProfile {
  id                        String                  @id @default(cuid())
  madrasaId                 String
  studentId                 String
  alumniIndexNumber         String                  @unique @db.VarChar(50)

  // Academic & Leaving Information
  admissionDate             DateTime                @db.Date
  leavingDate               DateTime                @db.Date
  leavingReason             String?                 @db.VarChar(100)
  completedProgrammes       Json?
  academicHighlights        Json?

  // Character Assessment (Deliberate evaluation, no automatic default)
  characterAssessmentRating CharacterConductRating?
  characterAssessmentText   String?                 @db.Text
  allowPublicConductShare   Boolean                 @default(false)

  // Publication Lifecycle
  publicationStatus         AlumniPublicationStatus @default(DRAFT)
  publishedAt               DateTime?
  publishedByUserId         String?
  revokedAt                 DateTime?
  revocationReason          String?                 @db.Text

  // Consent Evidence Tracking
  consentStatus             AlumniConsentStatus     @default(PENDING)
  consentGivenBy            AlumniConsentParty?
  consentSignerName         String?                 @db.VarChar(191)
  consentGrantedAt          DateTime?
  consentWithdrawnAt        DateTime?
  consentWithdrawnReason    String?                 @db.Text
  consentVersion            String                  @default("v1.0-2026") @db.VarChar(20)
  consentProofType          String?                 @db.VarChar(50)
  consentFileId             String?
  consentNotes              String?                 @db.Text

  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  // Relations
  madrasa              Madrasa                     @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  student              Student                     @relation(fields: [studentId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  consentFile          FileObject?                 @relation("AlumniConsentFile", fields: [consentFileId], references: [id], onDelete: SetNull)
  publishedByUser      User?                       @relation("AlumniPublishedBy", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  consentRecords       AlumniConsentRecord[]
  verificationRequests AlumniVerificationRequest[]

  @@unique([studentId, madrasaId])
  @@index([madrasaId, publicationStatus])
  @@index([publicationStatus, consentStatus])
  @@map("alumni_profiles")
}

/// Concurrency-safe tenant sequence tracker for permanent Alumni Index Numbers
model AlumniIndexSequence {
  id           String   @id @default(cuid())
  madrasaId    String
  year         Int
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt

  madrasa Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Restrict)

  @@unique([madrasaId, year])
  @@map("alumni_index_sequences")
}

/// Append-only immutable legal audit record of all consent actions
model AlumniConsentRecord {
  id               String               @id @default(cuid())
  alumniProfileId  String
  madrasaId        String
  action           AlumniConsentAction

  consentParty     AlumniConsentParty?
  signerName       String?              @db.VarChar(191)
  consentVersion   String               @db.VarChar(20)
  proofType        String?              @db.VarChar(50)
  evidenceFileId   String?
  withdrawalReason String?              @db.Text

  recordedByUserId String
  createdAt        DateTime             @default(now())

  alumniProfile  AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  madrasa        Madrasa       @relation(fields: [madrasaId], references: [id], onDelete: Restrict)
  evidenceFile   FileObject?   @relation("ConsentRecordEvidenceFile", fields: [evidenceFileId], references: [id], onDelete: SetNull)
  recordedByUser User          @relation("ConsentRecordRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([alumniProfileId, createdAt])
  @@index([madrasaId, createdAt])
  @@map("alumni_consent_records")
}

/// Cross-tenant academic verification requests between institutions
model AlumniVerificationRequest {
  id                  String                   @id @default(cuid())
  alumniProfileId     String
  targetMadrasaId     String
  requestingMadrasaId String
  requestedByUserId   String

  purpose             String                   @db.VarChar(255)
  specificInquiry     String?                  @db.Text
  includeCharacter    Boolean                  @default(false)

  status              AlumniVerificationStatus @default(PENDING)
  responseNotes       String?                  @db.Text
  respondedByUserId   String?
  respondedAt         DateTime?

  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  alumniProfile     AlumniProfile @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)
  targetMadrasa     Madrasa       @relation("AlumniTargetMadrasa", fields: [targetMadrasaId], references: [id], onDelete: Restrict)
  requestingMadrasa Madrasa       @relation("AlumniRequestingMadrasa", fields: [requestingMadrasaId], references: [id], onDelete: Restrict)
  requestedByUser   User          @relation("AlumniRequestedByUser", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  respondedByUser   User?         @relation("AlumniRespondedByUser", fields: [respondedByUserId], references: [id], onDelete: SetNull)

  @@index([targetMadrasaId, status])
  @@index([requestingMadrasaId, status])
  @@index([alumniProfileId])
  @@map("alumni_verification_requests")
}

/// Multi-instance database rate limit fallback using an atomic fixed-window counter
model RateLimitBucket {
  key       String   @id @db.VarChar(191)
  points    Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}

// ==========================================
// ADMISSIONS INTERVIEW MANAGEMENT MODELS
// ==========================================

model InterviewSchedule {
  id                  String                    @id @default(cuid())
  madrasaId           String
  madrasa             Madrasa                   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  admissionPeriodId   String
  admissionPeriod     AdmissionPeriod           @relation(fields: [admissionPeriodId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  interviewRound      InterviewRound            @default(FIRST)
  schedulingMethod    InterviewSchedulingMethod
  title               String                    @db.VarChar(191)
  interviewDate       DateTime                  @db.Date
  venue               String                    @db.VarChar(255)
  defaultStartTime    String?                   @db.VarChar(10)
  defaultEndTime      String?                   @db.VarChar(10)
  slotDurationMinutes Int?
  instructions        String?                   @db.Text
  requiredDocuments   Json?
  createdByUserId     String
  createdByUser       User                      @relation("ScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  appointments        InterviewAppointment[]

  @@unique([id, madrasaId])
  @@index([madrasaId, admissionPeriodId, interviewRound], map: "idx_schedules_period_round")
  @@index([madrasaId, interviewDate], map: "idx_schedules_madrasa_date")
  @@map("interview_schedules")
}

model InterviewAppointment {
  id                  String                     @id @default(cuid())
  madrasaId           String
  madrasa             Madrasa                    @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  scheduleId          String
  schedule            InterviewSchedule          @relation(fields: [scheduleId, madrasaId], references: [id, madrasaId], onDelete: Cascade)
  applicationId       String
  application         StudentApplication         @relation(fields: [applicationId, madrasaId], references: [id, madrasaId], onDelete: Restrict)
  interviewRound      InterviewRound             @default(FIRST)
  invitationReference String                     @unique @db.VarChar(64)
  interviewDate       DateTime                   @db.Date
  startTime           String                     @db.VarChar(10)
  endTime             String                     @db.VarChar(10)
  venue               String                     @db.VarChar(255)
  status              InterviewAppointmentStatus @default(SCHEDULED)
  rescheduledFromId   String?
  rescheduledFrom     InterviewAppointment?      @relation("RescheduledHistory", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo       InterviewAppointment[]     @relation("RescheduledHistory")
  cancellationReason  String?                    @db.Text
  rescheduleReason    String?                    @db.Text
  fileObjectId        String?
  fileObject          FileObject?                @relation("AppointmentInvitationFile", fields: [fileObjectId], references: [id], onDelete: SetNull)
  pdfVersion          Int                        @default(1)
  createdByUserId     String
  createdByUser       User                       @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  evaluation          InterviewEvaluation?
  notifications       InterviewNotification[]

  @@unique([id, madrasaId])
  @@index([madrasaId, scheduleId], map: "idx_appointments_schedule")
  @@index([madrasaId, applicationId, interviewRound], map: "idx_appointments_app_round")
  @@index([madrasaId, interviewDate, status], map: "idx_appointments_date_status")
  @@map("interview_appointments")
}

model InterviewEvaluation {
  id                    String               @id @default(cuid())
  madrasaId             String
  madrasa               Madrasa              @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  appointmentId         String               @unique
  appointment           InterviewAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  attendance            InterviewAttendance?
  quranRecitationScore  Decimal?             @db.Decimal(5, 2)
  islamicKnowledgeScore Decimal?             @db.Decimal(5, 2)
  academicScore         Decimal?             @db.Decimal(5, 2)
  conductScore          Decimal?             @db.Decimal(5, 2)
  totalScore            Decimal?             @db.Decimal(5, 2)
  interviewerNotes      String?              @db.Text
  recommendationNotes   String?              @db.Text
  result                InterviewResult      @default(PENDING)
  evaluatedByUserId     String
  evaluatedByUser       User                 @relation("EvaluationEvaluatedBy", fields: [evaluatedByUserId], references: [id], onDelete: Restrict)
  evaluatedAt           DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([id, madrasaId])
  @@index([madrasaId, result], map: "idx_evaluations_madrasa_result")
  @@index([madrasaId, attendance], map: "idx_evaluations_madrasa_attendance")
  @@map("interview_evaluations")
}

model InterviewNotification {
  id                String               @id @default(cuid())
  madrasaId         String
  madrasa           Madrasa              @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  appointmentId     String
  appointment       InterviewAppointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientEmail    String               @db.VarChar(255)
  recipientName     String               @db.VarChar(191)
  pdfVersion        Int                  @default(1)
  fileObjectId      String?
  fileObject        FileObject?          @relation("NotificationAttachmentFile", fields: [fileObjectId], references: [id], onDelete: SetNull)
  status            InterviewEmailStatus @default(PENDING)
  claimedAt         DateTime?
  leaseExpiresAt    DateTime?
  smtpMessageId     String?              @db.VarChar(255)
  sentAt            DateTime?
  errorDetails      String?              @db.Text
  uncertainDelivery Boolean              @default(false)
  retryCount        Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([id, madrasaId])
  @@index([madrasaId, appointmentId], map: "idx_notifications_madrasa_app")
  @@index([madrasaId, status, leaseExpiresAt], map: "idx_notifications_status_lease")
  @@map("interview_notifications")
}

/// Granular Feature Entitlement per Subscription Plan
model PlanFeature {
  id         String   @id @default(cuid())
  planId     String
  featureKey String   @db.VarChar(100)
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@index([planId])
  @@index([featureKey])
  @@map("plan_features")
}

/// Individual Madrasa Feature Grant or Deny Override
model MadrasaFeatureOverride {
  id              String       @id @default(cuid())
  madrasaId       String
  featureKey      String       @db.VarChar(100)
  overrideType    OverrideType @default(GRANT)
  reason          String       @db.Text
  startsAt        DateTime     @default(now())
  expiresAt       DateTime?
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  madrasa       Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  createdByUser User?   @relation("OverrideCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser User?   @relation("OverrideUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([madrasaId, featureKey])
  @@index([madrasaId])
  @@index([featureKey])
  @@index([expiresAt])
  @@map("madrasa_feature_overrides")
}

enum OverrideType {
  GRANT
  DENY
}
